JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAsNIemXHiEHYwCwmnKubV\n5oDP/tGmRTGHb0nuKZ2hpqaVDkYRPyZDWBPY+a/Np6Ps4q1cctvFB9DZJ4C2El67\njJoews/OkHfPgIJuRAJYRuYp0Gcg/FEcDc8WghVbzn+dKj0dCrDidywetZpPxIi1\nhxlgRzX/pDN6lMXFq2fjXE4t+9smaBJpx+vDT7mfWbIvmj9ww+Roct4AQQ3bFvYM\nkgXpgacgyq2OBOP0HUhSj8sRYc04eQp5c15gkhiuexarr+dzX3hai2dmKQdJ4k/4\nE4DaAwxmZDV2wGsGhdb9uhCVMrFwty2Y8lvarKYi+FaMpnAHvKSHZ7WE673FFwSv\nXwIDAQAB\n-----END PUBLIC KEY-----

# --- Seed admin (decision 3) — change the password outside dev ---
ADMIN_EMAIL=admin@sanad.tech
ADMIN_PASSWORD=change-me-admin

# --- Integration-secrets vault (settings-service, N13) ---
# AES-256-GCM master key — base64 of a 32-byte key. DEV THROWAWAY; a real key is REQUIRED
# in staging/prod (OPS1). Generate: `openssl rand -base64 32`.
APP_SECRETS_ENCRYPTION_KEY=c2FuYWQtZGV2LXNlY3JldHMtZW5jcnlwdGlvbi1rZXk=

# --- Email / SMTP (notifications-service) — OPTIONAL ---
# Unset → emails are logged to the console (dev-safe). The SMTP PASSWORD is a SECRET: prefer
# storing it in the encrypted vault (PUT /api/integration-secrets/SMTP_PASSWORD); SMTP_PASSWORD
# here is only the env fallback (DB → env → null, N13). Never commit a real password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_FROM=Sanad Tech <no-reply@sanad.tech>
SMTP_PASSWORD=
# Inbox that receives new-lead team alerts.
NOTIFICATIONS_TEAM_EMAIL=team@sanad.tech
# The language the TEAM reads its new-lead alerts in (ar|en) — staff are Arabic-first too (U24).
NOTIFICATIONS_TEAM_LOCALE=ar
