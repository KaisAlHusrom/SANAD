# Sanad dev stack — copy to .env.development and adjust. Real env files are gitignored
# (OPS1); compose also supplies these as inline ${VAR:-default}s so it boots with none.
# All branching in app code is by APP_ENV, never NODE_ENV (U19/OPS1).

APP_ENV=development

# --- Published host ports (Sanad-only block, won't collide with other projects) ---
NGINX_PORT=8190
POSTGRES_PORT=5440
REDIS_PORT=6390
RABBITMQ_PORT=5680
RABBITMQ_MGMT_PORT=15680
GATEWAY_PORT=3010

# --- Postgres (one container, one database per service via init SQL) ---
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad

# --- RabbitMQ ---
RABBITMQ_USER=sanad
RABBITMQ_PASSWORD=sanad

# --- identity-service host port ---
IDENTITY_PORT=3011

# --- settings-service host port ---
SETTINGS_PORT=3012

# --- media-service host port ---
MEDIA_PORT=3013

# --- content-service host port ---
CONTENT_PORT=3014

# --- notifications-service host port ---
NOTIFICATIONS_PORT=3015

# --- admin-portal (Vite) + website (Next.js) host ports ---
ADMIN_PORT=4200
WEBSITE_PORT=3020

# --- Cloudflare R2 (media-service) — OPTIONAL placeholders (decision 2026-06-23) ---
# The media-service boots without these; signed uploads return 503 until they're set.
# Put REAL values in gitignored infra/.env.development for the full upload round-trip.
# These are SECRETS — never commit real values, never store in the settings table.
# They will later move to the encrypted integration-secrets vault (see PROGRESS).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# S3 API endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public/CDN base the asset URL is built from, e.g. https://cdn.sanad.tech
# MUST be a publicly readable host (the r2.dev dev URL or your custom domain) — NOT the S3 API
# endpoint above: that host requires a signature, so every <img> would 403.
R2_PUBLIC_URL=

# --- Browser origins that upload directly to the bucket (media-service) ---
# The admin portal is a SPA: it PUTs bytes from the BROWSER straight to R2, so the bucket's CORS
# policy must allow these origins or every upload dies in preflight with a 403 (rules change-log
# 2026-07-20). media-service checks this and can write the policy itself from the Integrations
# page. Comma-separated. Dev default is the nginx origin the admin is served from.
ADMIN_PUBLIC_ORIGINS=http://localhost:8190

# --- Gateway edge hardening (P8.10.A) ---
# Browser origins allowed to call /api CROSS-origin. Deliberately EMPTY: the admin portal calls
# a relative `/api` through nginx (same origin, Bearer header not cookies) and the website
# fetches server-side, so nothing in the product needs CORS today. In development the accessor
# falls back to the local origins so the dev stack self-checks. Comma-separated.
GATEWAY_CORS_ALLOWED_ORIGINS=
#
# How many reverse proxies sit in front of the gateway. This decides which `X-Forwarded-For`
# entry Express resolves `req.ip` to — the value the rate limiter keys on and the audit trail
# records. Set it TOO LOW and every caller shares nginx's bucket (a self-inflicted DoS); set it
# TOO HIGH and the header becomes spoofable again and the limiter is bypassable.
#   1 = our nginx only (dev, and a plain VPS deploy)
#   2 = Cloudflare (or another CDN) in front of our nginx  ← P9 must decide this deliberately
TRUST_PROXY_HOPS=1

# --- JWT RS256 keypair (DEV THROWAWAY — regenerate for staging/prod, OPS1/U14) ---
# Identity signs with the private key; the gateway verifies with the public key.
# PEM stored single-line with literal \n (the env accessor restores newlines).
