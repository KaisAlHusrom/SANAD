{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "website",
  "projectType": "application",
  "sourceRoot": "apps/website/src",
  "tags": ["scope:web", "type:app"],
  "targets": {
    // `@nx/js/typescript` cannot infer a typecheck target here — Next mandates `noEmit` +
    // `composite: false` and rewrites tsconfig.json on every dev/build — so without this the
    // whole app is silently skipped by `nx run-many -t typecheck`.
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      // `^build` is REQUIRED, not cosmetic: tsconfig.json's `references` redirect every
      // @sanad/* import to that project's DECLARATION OUTPUT, so the program is built
      // .d.ts (197 of them) and zero lib source. Without this, a clean checkout has no
      // libs/*/dist to resolve against.
      "dependsOn": ["^build"],
      "inputs": [
        "production",
        "^production",
        { "externalDependencies": ["typescript", "next"] }
      ],
      "outputs": [],
      "options": {
        "cwd": "apps/website",
        "command": "tsc -p tsconfig.json --noEmit"
      }
    }
  }
}
