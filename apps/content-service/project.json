{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "content-service",
  "projectType": "application",
  "sourceRoot": "apps/content-service/src",
  "tags": ["scope:content", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/content-service",
        "command": "swc src -d dist --strip-leading-paths"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/content-service",
        "command": "swc src -d dist --strip-leading-paths && (swc src -d dist --watch --strip-leading-paths & node --enable-source-maps --watch dist/main.js)"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/content-service",
        "command": "drizzle-kit generate"
      }
    },
    "db-migrate": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/content-service",
        "command": "node --enable-source-maps dist/db/migrate.js"
      }
    }
  }
}
