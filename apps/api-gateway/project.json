{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "api-gateway",
  "projectType": "application",
  "sourceRoot": "apps/api-gateway/src",
  "tags": ["scope:gateway", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "apps/api-gateway",
        "command": "swc src -d dist --strip-leading-paths"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "cwd": "apps/api-gateway",
        "command": "swc src -d dist --strip-leading-paths && (swc src -d dist --watch --strip-leading-paths & node --enable-source-maps --watch dist/main.js)"
      }
    }
  }
}
